# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtual Environment
venv/
.venv/

# メディア
fixtures/screenshots/*.png
fixtures/**/*.mp4
fixtures/ocr_debug/**/*.png
test_frame_ffmpeg.png
capture_stream_test_last_frame.png

# プレイヤー実名を含む正解データ(得点者・アシスト名OCRの検証用など)
fixtures/screenshots/*.json

# fixture画面の説明に他プレイヤーの実名(得点者・アシスト名等)を含むため、
# fixtures/本体と同じ理由でGit追跡対象外にする(Issue #195)
docs/screen_states.md

# SQLite(実データは含めない方針)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 秘匿情報(配信キー等を扱うようになった場合の保険)
.env

# YouTube Data API連携(Issue #265)のOAuth認証情報。.envと同様の理由でGit管理外
client_secret.json
token.json

# OS由来のゴミファイル(Windows想定)
Thumbs.db
desktop.ini

# エディタ設定
.vscode/
.idea/

# Claude Codeのローカル設定(許可コマンド等、開発者ごとに異なるため共有しない)
.claude/settings.local.json

# Claude Codeの実行時生成物(プロセスIDを含むロックファイル)
.claude/scheduled_tasks.lock

# ログ
*.log

# ビルド成果物
dist/
build/
*.egg-info/

# 作業用一時ファイル(検証用スクリプト・画像など)
tmp/

# Issue #342: /rank-entry用の動画クリップ保存先。tmp/を手動整理した際に誤って
# 削除される事故があったため、tmp/とは独立したディレクトリにした
clips/
