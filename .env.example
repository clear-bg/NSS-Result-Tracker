# このファイルをコピーして .env を作成し、実際の値を設定してください。
# .env はプレイヤー名を含むため .gitignore 対象(git追跡されません)。
# このテンプレート(.env.example)のみ git で追跡します。

# 得点・アシストを記録する対象のプレイヤー名(カンマ区切り)。
# ここに書かれていないプレイヤーが得点者の場合、そのゴールは記録されません。
# main.py起動時に自動的に開く設定画面(/admin)からも編集できます。
ALLOWED_PLAYERS=YourName,FriendName

# ゴール/アシストをDBに記録する際、許可リスト(ALLOWED_PLAYERS)をどう扱うか(必須)。
# 設定画面(/admin)からも編集できます。
# all: 許可リストに関係なく得点者・アシストを両方そのまま記録する
# allowlist: 得点者・アシストのどちらかが許可リストにいれば、両方そのまま記録する
#            (例: 許可リストに「ブルドッグ」がいて、得点者=たなか・アシスト=ブルドッグなら
#            両方そのまま記録される)
# allowlist_redact: 得点者・アシストのどちらかが許可リストにいれば記録するが、
#                    許可リストに無い方の名前はNULLにする
#                    (例: 上記と同じ状況で、得点者=NULL・アシスト=ブルドッグとして記録される)
GOAL_RECORD_MODE=allowlist

# キャプチャ映像を取得するdshowデバイス名(必須)。通常は"OBS Virtual Camera"のままでよい。
# OBSのバージョン等でデバイス名が異なる場合のみ変更してください。
CAPTURE_DEVICE_NAME=OBS Virtual Camera

# キャプチャ解像度(必須)。OBSの出力解像度と必ず一致させてください(一致しないと映像が壊れます)。
CAPTURE_WIDTH=1920
CAPTURE_HEIGHT=1080

# 実キャプチャのfps(必須)。OBSの「設定→映像」の共通FPS値と必ず一致させてください
# (状態機械のデバウンス閾値のスケーリングに使うため、実際の値とズレると誤検知の原因になります。Issue #255)。
CAPTURE_FPS=30

# フレーム取得のタイムアウト秒数(必須)。
# キャプチャ環境によってフレーム取得が詰まりやすい場合に調整してください。
FRAME_READ_TIMEOUT_SECONDS=5.0

# DBファイルの保存先(必須)。
DB_PATH=nss_tracker.db

# ログの詳細度(必須)。DEBUG/INFO/WARNING/ERRORのいずれか。
# トラブルシューティング時にDEBUGへ変更すると詳細なログが出ます。
NSS_TRACKER_LOG_LEVEL=INFO

# 配信画面向けWebダッシュボードのバインド先ホスト・ポート(必須)。
WEB_HOST=127.0.0.1
WEB_PORT=8000

# ランク推移グラフの対象範囲(直近何試合分を表示するか、必須)。
# all で全期間を表示する。数値を指定すると直近その試合数分だけ表示する。
# 設定画面(/admin)からも編集できます。
RANK_GRAPH_MATCH_LIMIT=all

# 勝敗別ランク増減分布(箱ひげ図)の集計対象(必須)。
# session: 現在の配信セッションのみ / all: 累計(全期間)
# 設定画面(/admin)からも編集できます。
RANK_DELTA_DISTRIBUTION_SCOPE=session

# obs-websocketの接続設定(必須、OBSの「ツール」>「WebSocketサーバー設定」で確認できます)。
OBS_WEBSOCKET_HOST=127.0.0.1
OBS_WEBSOCKET_PORT=4455
# OBS側で認証を無効化している場合は none にしてください。
OBS_WEBSOCKET_PASSWORD=none

# 試合中(VS画面確定〜試合結果確定)に切り替えるOBSシーン名(必須)。
OBS_SCENE_IN_MATCH=InMatch
# 試合と試合の間(結果バナー表示〜次の試合開始まで)に切り替えるOBSシーン名(必須)。
OBS_SCENE_BETWEEN_MATCHES=BetweenMatches

# 起動時(OBS接続成功直後)に自動で再読み込みするOBSブラウザソース名(必須)。
# カンマ区切りで複数指定可。使わない場合は none にしてください。
OBS_BROWSER_SOURCE_NAMES=none

# 試合状態に応じてOBSシーンを自動切替するかどうか(必須)。/adminからも変更可能。
# true: 自動切替する / false: 自動切替しない(手動でシーンを操作する)
OBS_SCENE_SWITCHING_ENABLED=true

# YouTube Liveのチャットコメントから「次に潜る時間」(/overlay/dive-time)を
# 検知するかどうか(必須)。事前にscripts/youtube_oauth_setup.pyでのOAuth同意が必要
# (詳細はdocs/youtube_dive_time_setup.md参照)。
# true: 検知する / false: 検知しない(オーバーレイは常に未設定表示のまま)
YOUTUBE_CHAT_DIVE_TIME_ENABLED=false

# 次の試合のrank_beforeで直前の試合のrank_afterを補正する仕組みを行うかどうか(必須)。
# true: 補正する(既定) / false: 補正しない(直前の試合のrank_afterを一切書き換えない)
RANK_AFTER_CORRECTION_ENABLED=true
